<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The app itself talks to website/api, so this is needed in release
         builds too — src/debug/AndroidManifest.xml only covers the Flutter
         tooling's own connection. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <!-- Field-visit tracking. Fine location is what the route, stops and
         visit detection are built on; coarse is declared so the app still
         functions if the user grants approximate location only.

         ACCESS_BACKGROUND_LOCATION is deliberately NOT declared: the app only
         tracks while a work session is open and the session stream runs as a
         foreground service, which while-in-use permission covers. Add it only
         when always-on tracking is actually implemented. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- Camera and media for product photo uploads -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- An open session runs a location foreground service so tracking keeps
         recording with the screen off, and so the ongoing notification can show
         a live timer with Pause / End Day buttons. That service is owned by the
         flutter_foreground_task plugin (declared below); geolocator streams
         while-in-use inside it. FOREGROUND_SERVICE_LOCATION is required from
         API 34; WAKE_LOCK backs the service's wake lock so fixes arrive on time
         instead of in a burst on wake. FOREGROUND_SERVICE, WAKE_LOCK,
         POST_NOTIFICATIONS and the restart receivers are contributed by the
         plugin's own manifest and merged in. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <application
        android:label="Hazra EV${appNameSuffix}"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- The ongoing work-session foreground service (live timer + Pause /
             End Day buttons). The service class name is fixed by the
             flutter_foreground_task plugin and must not be changed. Typed as a
             location service because it keeps the GPS stream alive. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- Small icon for the ongoing work-session notification. Looked up by
             name from the application meta-data by flutter_foreground_task
             (ForegroundService.getIconResId), and named in Dart by
             SessionNotificationService — the two strings must stay in step.

             Without this the plugin falls back to the launcher icon, and
             setSmallIcon() keeps only the alpha channel of what it is given:
             an opaque launcher PNG becomes a solid white square in the status
             bar. @drawable/ic_stat_hazra is the alpha-only silhouette that
             fallback cannot be. -->
        <meta-data
            android:name="com.hazra.employeetracking.NOTIFICATION_ICON"
            android:resource="@drawable/ic_stat_hazra" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>

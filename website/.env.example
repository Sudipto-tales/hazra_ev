# Application settings
APP_NAME=Vayu
APP_ENV=development
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Database settings
# sqlite is the development default and needs nothing else set — the file lives
# at database/database.sqlite. Set DB_DATABASE to an absolute path to move it.
DB_TYPE=sqlite
DB_DATABASE=
# mysql / mongo only:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=

# JWT settings
# HS256 requires at least 32 bytes of key material; firebase/php-jwt refuses to
# sign a shorter one. Generate with: php -r 'echo bin2hex(random_bytes(32));'
JWT_SECRET=
JWT_TTL=3600

# CORS settings — comma-separated origins, or * in development
CORS_ORIGINS=*

# Road matching — turns the raw 15 s GPS trace into the streets that were
# ridden. Both defaults point at a public demo host with no SLA; a fleet needs
# a self-hosted instance.
#
#   osrm     — /match. Fastest matcher, but the profile is baked into the graph
#              at build time and stock OSRM ships car/bike/foot only, where
#              `bike` is a *bicycle*. A two-wheeler fleet needs an instance
#              built from a motorcycle.lua forked off car.lua.
#   valhalla — /trace_attributes. Ships `motorcycle` and `motor_scooter`
#              costings, chosen per request, and returns a confidence score.
#              Recommended for two-wheeler.
MATCH_ENABLED=true
MATCH_ENGINE=osrm
# osrm default https://router.project-osrm.org · valhalla default http://127.0.0.1:8002
MATCH_BASE_URL=
# osrm: A LABEL ONLY. osrm-extract compiles the profile into the graph and the
#       URL segment is ignored, so this cannot switch a car graph to a
#       two-wheeler one — it only records which graph you believe you built.
# valhalla: a real selector — costing name (motor_scooter|motorcycle|auto)
MATCH_PROFILE=
MATCH_TIMEOUT_SECONDS=12
# Coordinates per matcher request. Self-hosted OSRM defaults to 100
# (--max-matching-size); router.project-osrm.org caps /match at 10.
MATCH_MAX_COORDINATES=100

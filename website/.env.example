# ─────────────────────────────────────────────────────────────
# EXAMPLE TEMPLATE ONLY — this file is committed and public.
# Never put a real secret, password, host, or API key in here.
#
# Real values belong in `.env`, which is gitignored and must
# never be committed. Copy this file to `.env` and fill it in,
# or run `php vayu setup` (website/) to generate `.env` from
# this template — the wizard fills JWT_SECRET for you with a
# fresh random value (SetupCommand::generateJwtSecret()).
#
# Leaving a value blank here is deliberate: see the notes in
# core/JwtAuth.php and config/db.php — a blank JWT_SECRET
# silently falls back to an insecure default, so always set a
# real one in `.env`.
# ─────────────────────────────────────────────────────────────

# APP_NAME=Vayu
# APP_ENV=development
# APP_DEBUG=true
# APP_URL=http://127.0.0.1:8000


# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

APP_ENV=production
APP_DEBUG=false
APP_URL=https://hazraelectricalbike.com
CORS_ORIGINS=https://hazraelectricalbike.com
JWT_SECRET=
JWT_TTL=3600


# Road matching. Pointed at the public OSRM demo, which caps /match at 10
# coordinates — a self-hosted instance takes the 100 default.
# MATCH_ENABLED=true
# MATCH_ENGINE=osrm
# MATCH_MAX_COORDINATES=10

# DB_TYPE=sqlite
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hazra_ev
DB_USERNAME=hazra_ev_user
DB_PASSWORD=


# Road matching (disabled for local dev)
MATCH_ENABLED=false
MATCH_ENGINE=osrm
MATCH_BASE_URL=
MATCH_PROFILE=
MATCH_TIMEOUT_SECONDS=12
MATCH_MAX_COORDINATES=100


APP_RELEASE_STORAGE=storage/apk
# Public dealer map: standard OpenStreetMap tiles require no API key.
# Keep attribution visible and follow https://operations.osmfoundation.org/policies/tiles/
DEALER_GEOCODER_URL=https://photon.komoot.io/
DEALER_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
DEALER_MAP_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'

# Admin Google map: deployment supplies this from GitHub variable GOOGLE_MAPS_BROWSER_KEY.
# Restrict this browser key to your website domains in Google Cloud.
# Enable Maps JavaScript API, Places API (New), and Geocoding API.
GOOGLE_MAPS_BROWSER_KEY=

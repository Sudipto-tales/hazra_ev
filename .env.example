# ─────────────────────────────────────────────────────────────
# EXAMPLE TEMPLATE ONLY — this file is committed and public.
# Never put a real secret, password, host, or API key in here.
#
# Real values belong in `.env`, which is gitignored and must
# never be committed. Copy this file to `.env` and fill it in,
# or run `php vayu setup` (website/) to generate `.env` from
# this template — the wizard fills JWT_SECRET for you with a
# fresh random value (SetupCommand::generateJwtSecret()).
#
# Leaving a value blank here is deliberate: see the notes in
# core/JwtAuth.php and config/db.php — a blank JWT_SECRET
# silently falls back to an insecure default, so always set a
# real one in `.env`.
# ─────────────────────────────────────────────────────────────

# APP_NAME=Vayu
# APP_ENV=development
# APP_DEBUG=true
# APP_URL=http://127.0.0.1:8000


# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

APP_ENV=production
APP_DEBUG=false
APP_URL=https://hazraelectricalbike.com
CORS_ORIGINS=https://hazraelectricalbike.com
JWT_SECRET=
JWT_TTL=3600


# Road matching. Pointed at the public OSRM demo, which caps /match at 10
# coordinates — a self-hosted instance takes the 100 default.
# MATCH_ENABLED=true
# MATCH_ENGINE=osrm
# MATCH_MAX_COORDINATES=10

# DB_TYPE=sqlite
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hazra_ev
DB_USERNAME=hazra_ev_user
DB_PASSWORD=


# Road matching (disabled for local dev)
MATCH_ENABLED=false
MATCH_ENGINE=osrm
MATCH_BASE_URL=
MATCH_PROFILE=
MATCH_TIMEOUT_SECONDS=12
MATCH_MAX_COORDINATES=100


APP_RELEASE_STORAGE=storage/apk
# Public dealer map: standard OpenStreetMap tiles require no API key.
# Keep attribution visible and follow https://operations.osmfoundation.org/policies/tiles/
DEALER_GEOCODER_URL=https://photon.komoot.io/
DEALER_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
DEALER_MAP_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'

# Admin Google map: deployment supplies this from GitHub variable GOOGLE_MAPS_BROWSER_KEY.
# Restrict this browser key to your website domains in Google Cloud.
# Enable Maps JavaScript API, Places API (New), and Geocoding API.
GOOGLE_MAPS_BROWSER_KEY=

# ── APP_KEY: the messaging credential store ───────────────────
# Required before any provider credential can be SAVED from the
# admin panel. Generate with `php vayu key:generate`, paste here,
# and keep a copy: without this key every credential stored
# through the panel becomes unreadable, and there is no recovery.
# Rotating it is therefore not a routine action — the stored
# credentials must be re-entered afterwards.
# Also add the same value to the PROD_ENV_FILE deployment secret,
# or the next deploy writes an env without it.
APP_KEY=

# ── Messaging: Email + WhatsApp + SMS ─────────────────────────
# Credentials and webhook secrets are now managed in
# Admin → Settings → Messaging & Webhooks, where secrets are
# stored encrypted (AES-256-GCM, keyed by APP_KEY above).
#
# Every key below still works and is read as a FALLBACK: the
# resolution order is admin panel → the old website_settings rows
# → this file. Nothing has to be migrated out of here, and a
# server with no APP_KEY keeps running on these values alone.
# Saving the same field in the panel takes precedence from then on.
#
# The per-event delivery order (which channel is tried first, and
# what happens when one fails) is admin-managed too and lives in
# the messaging_routes table — never in env.
#
# Run `php vayu migrate` (migrations 028, 029, 032-035) before
# enabling messaging; the message log tables must exist first.
# Full setup narrative: website/docs/whatsapp.md

# WhatsApp Cloud API (Meta). Access token and phone number ID come
# from the Meta app's WhatsApp product page.
# WHATSAPP_VERIFY_TOKEN is a random string you invent and paste into
# Meta's webhook config; it must match on both sides.
# WHATSAPP_APP_SECRET validates the X-Hub-Signature-256 HMAC on
# inbound webhook calls — without it, inbound payloads are rejected.
# Webhook callback URL: <APP_URL>/api/v1/whatsapp/webhook (GET verify, POST events)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# SMS. SMS_PROVIDER is now only a FALLBACK: it names the SMS step of
# the OTP chain when the messaging_routes table is empty (a database
# that predates migration 032). Once the chain exists, every SMS
# provider with credentials is tried in the admin-configured order,
# so this value stops being consulted.
# `log` only writes the OTP to the error log and is refused unless
# APP_ENV is local, development, or testing — production must name a
# real provider.
SMS_PROVIDER=log

# MSG91 (the provider documented in website/docs/whatsapp.md).
# SMS_MSG91_WEBHOOK_TOKEN is a random string you invent; MSG91 sends it
# back as the X-SMS-Webhook-Token header on delivery reports.
# Delivery report URL: <APP_URL>/api/v1/sms/webhook/msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
SMS_MSG91_WEBHOOK_TOKEN=

# Twilio — alternative to MSG91; uncomment only if SMS_PROVIDER=twilio.
# SMS_TWILIO_CALLBACK_URL must be the externally visible https URL,
# character for character including any subdirectory, or signature
# validation fails. No fragment, no message_id — the sender appends
# its own message_id query parameter.
# Delivery status URL: <APP_URL>/api/v1/sms/webhook/twilio
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=
# SMS_TWILIO_CALLBACK_URL=

# Fast2SMS — the third SMS option. FAST2SMS_ROUTE is `otp` or `dlt`:
# `otp` sends Fast2SMS's own fixed wording and needs neither a DLT
# template nor a sender ID; `dlt` uses your approved template and
# requires both. Send-only — Fast2SMS does not document the payload
# or headers of its delivery-report webhook and signs nothing, so
# these sends stay at `accepted` and never reach `delivered`.
# FAST2SMS_API_KEY=
# FAST2SMS_ROUTE=otp
# FAST2SMS_SENDER_ID=
# FAST2SMS_MESSAGE_ID=

# WhatsApp through MSG91 — the indirect route, as an alternative to
# Meta Cloud API above. MSG91 holds the Meta integration, so no app
# secret, verify token or phone number ID is needed. The integrated
# number, templates and namespace are panel-only; the authkey is
# shared with MSG91 SMS above.
# Delivery report URL: <APP_URL>/api/v1/whatsapp/webhook/msg91
# (MSG91 → Webhook (New) → Outbound Report Received, with the
#  generated X-WA-Webhook-Token custom header.)

# SMTP — the email channel, and the default first step of every
# delivery order. These used to live only in website_settings; the
# password is now stored encrypted when saved from the panel.
# core/Mailer.php no longer has a hardcoded fallback account, so an
# unconfigured mailer fails loudly instead of sending from one.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_ENCRYPTION=tls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=Hazra EV
